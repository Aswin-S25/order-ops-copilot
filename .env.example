# Copy to .env and fill in real values. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Runtime database role: app_user (NOBYPASSRLS, owns no tables). See ADR-0003.
# Use 127.0.0.1 (not localhost) and port 5433: see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://app_user:change-me@127.0.0.1:5433/orderops
REDIS_URL=redis://127.0.0.1:6379/0

OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=replace-with-a-tool-calling-model

# --- Docker Compose (dev only) -------------------------------------------
# Read ONCE by the Postgres init script when the volume is first created.
# Generate each with: openssl rand -hex 24   (hex avoids @ / : characters that break URLs)
POSTGRES_SUPERUSER_PASSWORD=change-me
APP_OWNER_PASSWORD=change-me
APP_USER_PASSWORD=change-me

# Migrations only (Step 1.6). Never given to the API or worker processes.
DATABASE_OWNER_URL=postgresql+asyncpg://app_owner:change-me@127.0.0.1:5433/orderops

SEED_USER_PASSWORD=change-me-to-12-plus-chars

JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
