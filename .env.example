# Copy to .env and fill in real values. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Runtime database role: app_user (NOBYPASSRLS, owns no tables). See ADR-0003.
DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/orderops
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=replace-with-a-tool-calling-model